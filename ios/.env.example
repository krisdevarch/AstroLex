# Copy to ios/.env.local (gitignored) and fill in. Read by scripts/ios/*.sh.
# Team ID: developer.apple.com > Account > Membership details (10 characters).
DEVELOPMENT_TEAM=ABCDE12345
# Bundle ID you registered for the app (Certificates, Identifiers & Profiles).
ASTROLEX_BUNDLE_ID=com.example.astrolex
# App Store Connect API key (Users and Access > Integrations > App Store Connect API, role App Manager).
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Where the downloaded AuthKey_<KEY_ID>.p8 lives. Keep it outside the repo.
ASC_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8
# Optional: external TestFlight group (public link for friends). Builds go there with --friends.
ASC_FRIENDS_GROUP=Friends
# Optional: simulator used for tests before each ship.
# SIM_DEVICE="iPhone 17 Pro"  # default: newest available iPhone simulator
