{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "templates"],
  "properties": {
    "$schema": {"type": "string"},
    "status": {"enum": ["draft", "approved"]},
    "notes": {"type": "string"},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pattern"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "pattern": {"type": "string", "minLength": 3},
          "note": {"type": "string"}
        }
      }
    }
  }
}
