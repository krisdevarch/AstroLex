{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroLex Catcher suits (WP-B.3)",
  "type": "object",
  "required": ["status", "characters"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "status": {"enum": ["draft", "approved"]},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "colour", "perk", "mod"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+$"},
          "name": {"type": "string", "minLength": 1},
          "colour": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "perk": {"type": "string", "minLength": 1, "maxLength": 80},
          "mod": {"$ref": "#/$defs/mod"}
        }
      }
    }
  },
  "$defs": {
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {"type": "object", "additionalProperties": {"type": "number"}},
        "mul": {"type": "object", "additionalProperties": {"type": "number"}},
        "add": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    }
  }
}
