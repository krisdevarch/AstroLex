{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroLex difficulty levels (WP-B.3)",
  "type": "object",
  "required": ["default", "levels"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "default": {"type": "string"},
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "blurb", "mod"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+$"},
          "label": {"type": "string", "minLength": 1},
          "blurb": {"type": "string", "minLength": 1},
          "mod": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "set": {"type": "object", "additionalProperties": {"type": "number"}},
              "mul": {"type": "object", "additionalProperties": {"type": "number"}},
              "add": {"type": "object", "additionalProperties": {"type": "number"}}
            }
          }
        }
      }
    }
  }
}
