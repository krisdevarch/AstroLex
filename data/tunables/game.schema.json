{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroLex Godot client tunables (plan Part 8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tether.travelTime",
    "tether.travelMinMul",
    "tether.travelDistMul",
    "tether.hitTolerance",
    "tether.driftToleranceMul",
    "tap.marginPx",
    "tap.driftMarginMul",
    "drift.speed",
    "drift.speedVariation",
    "spawner.decoys",
    "spawner.frontShare",
    "spawner.wordsPerLevel",
    "score.letterValue",
    "score.lengthStep",
    "combo.step",
    "combo.max",
    "ramp.driftStep",
    "ramp.decoyStep",
    "ramp.decoyMax",
    "babel.showSeconds",
    "babel.minLineLetters",
    "babel.throwOriginX",
    "babel.throwOriginY",
    "babel.throwSec",
    "babel.throwStagger",
    "babel.throwOvershoot",
    "babel.riftRadius",
    "sim.stepSec",
    "field.height",
    "field.topMargin",
    "tile.size",
    "plane.frontScale",
    "plane.midScale",
    "plane.backScale",
    "plane.backAlpha",
    "plane.backSpeedMul",
    "plane.backDesaturate",
    "plane.backTiles",
    "tile.maxTiltDeg",
    "tile.swayDeg",
    "tile.swaySpeed",
    "tile.shadowOffset",
    "glass.blur",
    "glass.refractPx",
    "glass.frost",
    "glass.specular",
    "glass.edgeTint",
    "glass.chroma",
    "glass.grain",
    "glass.milk",
    "glass.bubbleScale",
    "fx.flyToSlotSec",
    "fx.dissolveSec",
    "hud.hintAlpha",
    "autoplay.tapInterval",
    "burst.seconds",
    "burst.wrongCost",
    "burst.restoreBonus",
    "score.timeBonus",
    "stars.three",
    "stars.two",
    "thief.firstAt",
    "thief.interval",
    "thief.max",
    "thief.speed",
    "thief.fleeSpeed",
    "thief.radius",
    "thief.stealCost",
    "thief.respawnDelay"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tether.travelTime": {
      "type": "number",
      "minimum": 0,
      "description": "seconds for the tether to reach a tile at mid range"
    },
    "tether.travelMinMul": {
      "type": "number",
      "minimum": 0,
      "description": "travel time multiplier at zero distance"
    },
    "tether.travelDistMul": {
      "type": "number",
      "minimum": 0,
      "description": "extra travel time multiplier at a full field height of distance"
    },
    "tether.hitTolerance": {
      "type": "number",
      "minimum": 0,
      "description": "field units: how far a tile may drift during travel and still be caught"
    },
    "tether.driftToleranceMul": {
      "type": "number",
      "minimum": 0,
      "description": "Drift mode multiplier on tether.hitTolerance"
    },
    "tap.marginPx": {
      "type": "number",
      "minimum": 0,
      "description": "screen px (1080 base) added to a tile's drawn radius for hit testing"
    },
    "tap.driftMarginMul": {
      "type": "number",
      "minimum": 0,
      "description": "Drift mode multiplier on the tap radius"
    },
    "drift.speed": {
      "type": "number",
      "minimum": 0,
      "description": "field units per second, before per-tile variation"
    },
    "drift.speedVariation": {
      "type": "number",
      "minimum": 0,
      "description": "fraction of drift.speed each tile varies by"
    },
    "spawner.decoys": {
      "type": "integer",
      "minimum": 0,
      "description": "decoys on the board in round 1"
    },
    "spawner.frontShare": {
      "type": "number",
      "minimum": 0,
      "description": "share of catchable tiles that start on the front plane"
    },
    "spawner.wordsPerLevel": {
      "type": "integer",
      "minimum": 0,
      "description": "words per round"
    },
    "score.letterValue": {
      "type": "number",
      "minimum": 0,
      "description": "points per letter"
    },
    "score.lengthStep": {
      "type": "number",
      "minimum": 0,
      "description": "bonus per letter beyond 3"
    },
    "combo.step": {
      "type": "number",
      "minimum": 0,
      "description": "combo gain per catch"
    },
    "combo.max": {
      "type": "number",
      "minimum": 0,
      "description": "combo cap"
    },
    "ramp.driftStep": {
      "type": "number",
      "minimum": 0,
      "description": "drift speed gain per round after the first"
    },
    "ramp.decoyStep": {
      "type": "integer",
      "minimum": 0,
      "description": "extra decoys per round after the first"
    },
    "ramp.decoyMax": {
      "type": "integer",
      "minimum": 0,
      "description": "decoy cap"
    },
    "babel.showSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "seconds a Babel line stays on screen"
    },
    "babel.throwOriginX": {
      "type": "number",
      "minimum": 0,
      "description": "rift x in field units (1 = field width)"
    },
    "babel.throwOriginY": {
      "type": "number",
      "minimum": 0,
      "description": "rift y in field units"
    },
    "babel.throwSec": {
      "type": "number",
      "minimum": 0,
      "description": "seconds one thrown tile takes to land (also the reduced-motion fade)"
    },
    "babel.throwStagger": {
      "type": "number",
      "minimum": 0,
      "description": "seconds between consecutive tile launches"
    },
    "babel.throwOvershoot": {
      "type": "number",
      "minimum": 0,
      "description": "back-ease overshoot of a thrown tile"
    },
    "babel.riftRadius": {
      "type": "number",
      "minimum": 0,
      "description": "Babel rift core radius in field units"
    },
    "babel.minLineLetters": {
      "type": "integer",
      "minimum": 0,
      "description": "shortest Babel line in letters"
    },
    "sim.stepSec": {
      "type": "number",
      "minimum": 0,
      "description": "fixed simulation step in seconds"
    },
    "field.height": {
      "type": "number",
      "minimum": 0,
      "description": "field height in field units (width is 1.0)"
    },
    "field.topMargin": {
      "type": "number",
      "minimum": 0,
      "description": "field units reserved at the top for the HUD"
    },
    "tile.size": {
      "type": "number",
      "minimum": 0,
      "description": "tile edge in field units on the front plane"
    },
    "plane.frontScale": {
      "type": "number",
      "minimum": 0,
      "description": "draw and hit scale of the front plane"
    },
    "plane.midScale": {
      "type": "number",
      "minimum": 0,
      "description": "draw and hit scale of the mid plane"
    },
    "plane.backScale": {
      "type": "number",
      "minimum": 0,
      "description": "draw scale of the back plane (background, not catchable)"
    },
    "plane.backAlpha": {
      "type": "number",
      "minimum": 0,
      "description": "whole-tile opacity of back-plane tiles"
    },
    "plane.backSpeedMul": {
      "type": "number",
      "minimum": 0,
      "description": "drift speed multiplier for back-plane tiles (parallax)"
    },
    "plane.backDesaturate": {
      "type": "number",
      "minimum": 0,
      "description": "0..1 colour removal on back-plane tiles"
    },
    "plane.backTiles": {
      "type": "integer",
      "minimum": 0,
      "description": "decorative back-plane tiles (not catchable)"
    },
    "tile.maxTiltDeg": {
      "type": "number",
      "minimum": 0,
      "description": "2.5D tile: maximum perspective tilt"
    },
    "tile.swayDeg": {
      "type": "number",
      "minimum": 0,
      "description": "2.5D tile: idle sway amplitude"
    },
    "tile.swaySpeed": {
      "type": "number",
      "minimum": 0,
      "description": "2.5D tile: sway cycles per second"
    },
    "tile.shadowOffset": {
      "type": "number",
      "minimum": 0,
      "description": "screen px drop-shadow offset on the front plane"
    },
    "glass.blur": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: sky blur strength, 0..1 (mip level scale)"
    },
    "glass.refractPx": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "description": "glass tile: edge refraction in screen px"
    },
    "glass.frost": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: dark frost alpha behind the glyph"
    },
    "glass.specular": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: highlight strength"
    },
    "glass.chroma": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: colour fringe at the bevel (red and blue split)"
    },
    "glass.bubbleScale": {
      "type": "number",
      "minimum": 1,
      "maximum": 2,
      "description": "bubble look: ball size relative to the tile (the letter keeps its size; visual only, the catch radius is unchanged)"
    },
    "glass.milk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: faint milky lift of the clear glass"
    },
    "glass.grain": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: fine grain on the glass"
    },
    "glass.edgeTint": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "glass tile: rim and bottom accent tint strength"
    },
    "hud.hintAlpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "alpha of the ghost letter shown in an unfilled word slot by the Hint setting"
    },
    "fx.flyToSlotSec": {
      "type": "number",
      "minimum": 0,
      "description": "seconds for a caught tile to fly to its slot"
    },
    "fx.dissolveSec": {
      "type": "number",
      "minimum": 0,
      "description": "seconds for a surplus tile to dissolve"
    },
    "autoplay.tapInterval": {
      "type": "number",
      "minimum": 0,
      "description": "seconds between autoplay taps (smoke tests)"
    },
    "burst.seconds": {
      "type": "number",
      "minimum": 1,
      "description": "burst length in seconds"
    },
    "burst.wrongCost": {
      "type": "number",
      "minimum": 0,
      "description": "seconds lost per wrong catch"
    },
    "burst.restoreBonus": {
      "type": "number",
      "minimum": 0,
      "description": "seconds gained per restored word"
    },
    "score.timeBonus": {
      "type": "number",
      "minimum": 0,
      "description": "win: points per second left"
    },
    "stars.three": {
      "type": "number",
      "minimum": 0,
      "description": "seconds left for three stars"
    },
    "stars.two": {
      "type": "number",
      "minimum": 0,
      "description": "seconds left for two stars"
    },
    "thief.firstAt": {
      "type": "number",
      "minimum": 0,
      "description": "seconds until the first Babel thief"
    },
    "thief.interval": {
      "type": "number",
      "minimum": 0,
      "description": "seconds between thief spawns; 0 = no thieves"
    },
    "thief.max": {
      "type": "integer",
      "minimum": 0,
      "description": "thieves alive at once"
    },
    "thief.speed": {
      "type": "number",
      "minimum": 0,
      "description": "thief seek speed, field units per second"
    },
    "thief.fleeSpeed": {
      "type": "number",
      "minimum": 0,
      "description": "speed of a thief carrying a letter, flying up"
    },
    "thief.radius": {
      "type": "number",
      "minimum": 0,
      "description": "thief grab/hit radius, field units"
    },
    "thief.stealCost": {
      "type": "number",
      "minimum": 0,
      "description": "seconds lost when a thief escapes with a letter"
    },
    "thief.respawnDelay": {
      "type": "number",
      "minimum": 0,
      "description": "seconds before a stolen letter respawns"
    }
  }
}
