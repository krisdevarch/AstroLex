{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroLex act level file (WP-4.5a)",
  "type": "object",
  "required": ["status", "act", "levels"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "status": {"enum": ["draft", "approved"]},
    "act": {"type": "string"},
    "tuning": {"$ref": "#/$defs/tuning", "description": "act defaults under every level's own tuning (level keys win); baked into each level on export"},
    "levels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}}
  },
  "$defs": {
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spawner.decoys": {"type": "integer", "minimum": 0},
        "drift.speed": {"type": "number"},
        "oxygen.drainPerSec": {"type": "number"},
        "burst.seconds": {"type": "number", "minimum": 1},
        "burst.perLetterSec": {"type": "number", "minimum": 0},
        "thief.interval": {"type": "number"},
        "thief.firstAt": {"type": "number"},
        "thief.speed": {"type": "number"},
        "thief.max": {"type": "integer", "minimum": 0},
        "thief.sideShare": {"type": "number", "minimum": 0, "maximum": 1},
        "plane.backTiles": {"type": "integer", "minimum": 0},
        "hazard.counterfeitRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "hazard.traps": {"type": "integer", "minimum": 0, "maximum": 1},
        "hazard.trapCost": {"type": "number", "minimum": 0},
        "hazard.stroop": {"type": "integer", "minimum": 0, "maximum": 1},
        "hazard.stroopEverySec": {"type": "number", "minimum": 1},
        "hazard.stroopSec": {"type": "number", "minimum": 0}
      }
    },
    "comm": {
      "type": "object",
      "required": ["who", "text"],
      "additionalProperties": false,
      "properties": {
        "who": {"enum": ["rhee", "ade", "kit", "vanta", "tomas", "babel", "catcher"]},
        "text": {"type": "string", "minLength": 1, "description": "for catcher: the line when no suit is picked"},
        "lines": {
          "type": "object",
          "description": "catcher only (WP-F.27): the picked suit's own reply",
          "additionalProperties": false,
          "required": ["wren", "juno", "ash", "pip"],
          "properties": {
            "wren": {"type": "string", "minLength": 1},
            "juno": {"type": "string", "minLength": 1},
            "ash": {"type": "string", "minLength": 1},
            "pip": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "level": {
      "type": "object",
      "required": ["id", "order", "title", "beat", "pacing", "words", "seed", "babel", "tuning", "commsBefore", "commsAfter"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]-[0-9]{2}$"},
        "order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "beat": {"type": "string"},
        "pacing": {"enum": ["teach", "core", "rest", "twist", "encounter"]},
        "words": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]+$"}},
        "seed": {"type": "integer"},
        "babel": {"type": "boolean"},
        "vanta": {"type": "number", "minimum": 1, "description": "VANTA's time on this level in seconds, as VANTA says it in the comms (WP-F.27); the end card shows it after a win"},
        "babelIntro": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Babel's line in his bubble when he flies in at the start of the level (owner, 16 Oct 2026); draft until the owner approves the file"},
        "tuning": {"$ref": "#/$defs/tuning"},
        "commsBefore": {"type": "array", "items": {"$ref": "#/$defs/comm"}},
        "commsAfter": {"type": "array", "items": {"$ref": "#/$defs/comm"}}
      }
    }
  }
}
